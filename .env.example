# Server-only. Never prefix this value with VITE_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Production server. PORT may be supplied by a hosting platform.
HOST=0.0.0.0
PORT=3000
BUILD_SHA=local
API_RATE_LIMIT_PER_MINUTE=30

# Set only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
